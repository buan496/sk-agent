{
  "id": "sk-repo-sync-index-graph",
  "name": "SK Repo Sync + Index + Graph",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SK_AGENT_API_BASE_URL || 'http://backend:8000'}}/repo/sync",
        "sendBody": false,
        "options": {
          "timeout": 300000
        }
      },
      "id": "sync-repo",
      "name": "Sync SK Repo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 90]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SK_AGENT_API_BASE_URL || 'http://backend:8000'}}/index/rebuild",
        "sendBody": false,
        "options": {
          "timeout": 600000
        }
      },
      "id": "rebuild-index",
      "name": "Rebuild Index",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 90]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SK_AGENT_API_BASE_URL || 'http://backend:8000'}}/graph/rebuild",
        "sendBody": false,
        "options": {
          "timeout": 600000
        }
      },
      "id": "rebuild-graph",
      "name": "Rebuild Graph",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 90]
    },
    {
      "parameters": {
        "url": "={{$env.SK_AGENT_API_BASE_URL || 'http://backend:8000'}}/graph/status",
        "options": {
          "timeout": 120000
        }
      },
      "id": "graph-status",
      "name": "Graph Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 90]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Sync SK Repo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Sync SK Repo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync SK Repo": {
      "main": [
        [
          {
            "node": "Rebuild Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rebuild Index": {
      "main": [
        [
          {
            "node": "Rebuild Graph",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rebuild Graph": {
      "main": [
        [
          {
            "node": "Graph Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
