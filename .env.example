# Local SK repository path. This is the preferred mode for phase 1.
LOCAL_REPO_PATH=D:\path\to\your\sk-repo

# Dual repository boundary.
# SK is indexed as content/cases/status/methodology.
# SKGPT is reserved for Project Instructions, GPTS config, upload lists, and read-current protocol.
SK_REPO_URL=https://github.com/MRYGP/SK.git
SKGPT_REPO_URL=
SK_REPO_LOCAL_PATH=
SKGPT_REPO_LOCAL_PATH=

# GitHub mode: set LOCAL_REPO_PATH empty, then configure GitHub.
# LOCAL_REPO_PATH=
# GITHUB_REPO=MRYGP/SK
# GITHUB_BRANCH=main
# GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com/MRYGP/SK/main

# Docker Compose uses this host path and mounts it read-only to /sk-repo.
SK_REPO_PATH=D:/path/to/your/sk-repo

# Auto-sync mode. Backend /repo/sync clones or pulls this repository into REPO_SYNC_PATH.
REPO_SYNC_URL=https://github.com/MRYGP/SK.git
REPO_SYNC_PATH=/repo-cache/SK

# Optional base image overrides, useful when Docker Hub is slow or blocked.
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:20-alpine
POSTGRES_IMAGE=pgvector/pgvector:pg16
NEO4J_IMAGE=neo4j:5-community

POSTGRES_DB=sk_agent
POSTGRES_USER=sk_agent
POSTGRES_PASSWORD=sk_agent

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sk_agent_neo4j

N8N_IMAGE=n8nio/n8n:latest
N8N_ENCRYPTION_KEY=change-me-local-only
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=sk_agent_n8n
GENERIC_TIMEZONE=Asia/Shanghai

# Optional GitHub raw mode:
# GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com/owner/repo/main

# Optional GitHub API mode:
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
# GITHUB_TOKEN=

# MiniMax 国内版 LLM mode. Keep the real key in .env only.
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_CHAT_ENDPOINT=/chat/completions
MINIMAX_CHAT_MODEL=MiniMax-M2.7
MINIMAX_TEMPERATURE=0.2
